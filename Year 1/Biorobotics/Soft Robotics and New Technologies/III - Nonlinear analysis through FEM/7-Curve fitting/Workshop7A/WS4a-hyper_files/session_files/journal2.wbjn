matlProp4 = matl1.CreateProperty(
    Name="Yeoh",
    Definition="3rd Order",
    Qualifiers={"Definition": "3rd Order", "Behavior": ""})
materialPropertyData1 = matlProp4.GetPropertyData(
    Name="Yeoh",
    Qualifiers={"Definition": "3rd Order", "Behavior": ""})
curveFit1 = materialPropertyData1.CreateCurveFitting(
    Type="Yeoh",
    Definition="3rd Order")
curveFit1.AddTestData(TestData=matlProp1)
curveFit1.AddTestData(TestData=matlProp2)
curveFit1.AddTestData(TestData=matlProp3)
curveFit1.Solve()
curveFitData1 = curveFit1.CurveFitData
curveFitData1.SetQualifier(
    SheetName="Yeoh",
    SheetQualifiers={"Definition": "3rd Order", "Behavior": "", "Error Norm for Fit": "Normalized Error"},
    Qualifier="Error Norm for Fit",
    Value="Absolute Error")
curveFit1.Solve()
curveFit1.CopyCoefficients(Destination=materialPropertyData1)
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit()
Save(Overwrite=True)
